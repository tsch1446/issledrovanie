{
  "name": "dr-bot",
  "version": "1.0.0",
  "description": "Telegram Mini App for a disguised birthday invitation quiz",
  "main": "dist/index.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.json",
    "build:web": "esbuild web/src/main.ts --bundle --outfile=public/app.js --platform=browser --target=es2019 --format=iife --minify",
    "build": "npm run build:server && npm run build:web",
    "watch:web": "esbuild web/src/main.ts --bundle --outfile=public/app.js --platform=browser --target=es2019 --format=iife --watch --sourcemap",
    "dev:server": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev": "npm-run-all -p dev:server watch:web",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "esbuild": "^0.23.0",
    "npm-run-all": "^4.1.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  }
}
