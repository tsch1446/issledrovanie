BOT_TOKEN=put_your_bot_token_here
ADMIN_TELEGRAM_ID=123456789
NODE_ENV=development
PORT=3000

# Публичный HTTPS URL, на котором будет жить Mini App (Render даст вида https://app-name.onrender.com)
# В dev можно использовать ngrok/Cloudflare Tunnel. Должен быть HTTPS, без него Telegram WebApp не откроется.
PUBLIC_URL=https://example.onrender.com
