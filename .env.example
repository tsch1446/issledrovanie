BOT_TOKEN=put_your_bot_token_here
ADMIN_TELEGRAM_ID=123456789
NODE_ENV=development

# Mini App URL. На Vercel - адрес деплоя, например https://issledrovanie-xxx.vercel.app
PUBLIC_URL=https://example.vercel.app

# Turso (libsql) - см. README
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=put_your_turso_token_here

# Random secret to verify Telegram webhook authenticity (any long random string)
TELEGRAM_WEBHOOK_SECRET=change_me_to_random_string
